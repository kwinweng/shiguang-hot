<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE plist PUBLIC "-//Apple//DTD PLIST 1.0//EN" "http://www.apple.com/DTDs/PropertyList-1.0.dtd">
<plist version="1.0">
<dict>
    <key>Label</key>
    <string>local.shiguang.news-publish</string>
    <key>UserName</key>
    <string>kwin</string>
    <key>WorkingDirectory</key>
    <string>/Users/kwin/projects/shiguang-news-publish/checkout</string>
    <key>ProgramArguments</key>
    <array>
        <string>/Users/kwin/projects/shiguang-news-publish/venv/bin/python3</string>
        <string>-I</string>
        <string>/Users/kwin/projects/shiguang-news-publish/bin/mac_publish_launcher.py</string>
    </array>
    <key>EnvironmentVariables</key>
    <dict>
        <key>PATH</key>
        <string>/Users/kwin/projects/shiguang-news-publish/venv/bin:/opt/homebrew/bin:/usr/bin:/bin</string>
        <key>BOX_PYTHON</key>
        <string>/Users/kwin/projects/shiguang-news-publish/venv/bin/python3</string>
        <key>HOME</key>
        <string>/Users/kwin</string>
    </dict>
    <key>StartCalendarInterval</key>
    <dict>
        <key>Minute</key>
        <integer>5</integer>
    </dict>
    <key>StandardOutPath</key>
    <string>/Users/kwin/projects/shiguang-news-publish/log/publish.log</string>
    <key>StandardErrorPath</key>
    <string>/Users/kwin/projects/shiguang-news-publish/log/publish.err.log</string>
</dict>
</plist>
