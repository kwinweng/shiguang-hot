il/1080x%3E"}],"quote":null,"avatar":"https://cdnv2.ruguoapp.com/o_1aif987v84gp1jcb17p11p9714nni0j?imageMogr2/auto-orient/heic-exif/1/format/jpeg/thumbnail/1000x1000%3E"},"translated":false},{"id":"jike-7B1385A9-FCC9-4446-B8CE-472EAF6817B2:https://m.okjike.com/originalPosts/6af79db3136b2761c64ca316","kind":"post","channel":null,"source_id":"jike-7B1385A9-FCC9-4446-B8CE-472EAF6817B2","source_name":"少楠Plidezus","title":"","summary":"昨天给 grokbot 升级到了新的套餐 然后把 Codex 退订到更低一档 前者模型能力未必更好 但很多业务工作流跑在了上面 折腾一下成本挺高 而 Codex 主要写代码 很容易替换 一个奇妙的体感，记一下","body":"昨天给 grokbot 升级到了新的套餐\n\n然后把 Codex 退订到更低一档\n\n前者模型能力未必更好\n\n但很多业务工作流跑在了上面\n\n折腾一下成本挺高\n\n而 Codex 主要写代码\n\n很容易替换\n\n一个奇妙的体感，记一下","url":"https://m.okjike.com/originalPosts/6af79db3136b2761c64ca316","image":{"url":"https://cdnv2.ruguoapp.com/FhTYA4YHPvQL5upJSmB3OdHXl1BUv3.jpg"},"published_at":"2026-11-14T07:30:59+08:00","fetched_at":"2026-11-26T15:09:32+08:00","lang":"zh","blogger":{"platform":"jike","handle":"7B1385A9-FCC9-4446-B8CE-472EAF6817B2","display_name":"少楠Plidezus","media":[{"type":"image","url":"https://cdnv2.ruguoapp.com/FhTYA4YHPvQL5upJSmB3OdHXl1BUv3.jpg"}],"quote":null,"avatar":"https://cdnv2.ruguoapp.com/FmtwuafewTTtdX3XezBXlN2OsOvDv3.jpg?imageMogr2/auto-orient/heic-exif/1/format/jpeg/thumbnail/!1000x1000r/gravity/Center/crop/!1000x1000a0a0"},"translated":false},{"id":"jike-7B1385A9-FCC9-4446-B8CE-472EAF6817B2:https://m.okjike.com/reposts/6af6f7793ce945612ecbf4ab","kind":"post","channel":null,"source_id":"jike-7B1385A9-FCC9-4446-B8CE-472EAF6817B2","source_name":"少楠Plidezus","title":"","summary":"祛魅了，而且写作本身也是思考过程，自得其乐就好。","body":"祛魅了，而且写作本身也是思考过程，自得其乐就好。","url":"https://m.okjike.com/reposts/6af6f7793ce945612ecbf4ab","image":{"url":"https://cdnv2.ruguoapp.com/FnMH8BJRqQInCgfatlQBEqVKr6UGv3.png?imageMogr2/auto-orient/thumbnail/300x2000%3E"},"published_at":"2026-11-13T19:41:45+08:00","fetched_at":"2026-11-26T15:09:32+08:00","lang":"zh","blogger":{"platform":"jike","handle":"7B1385A9-FCC9-4446-B8CE-472EAF6817B2","display_name":"少楠Plidezus","media":[{"type":"image","url":"https://cdnv2.ruguoapp.com/FnMH8BJRqQInCgfatlQBEqVKr6UGv3.png?imageMogr2/auto-orient/thumbnail/300x2000%3E"}],"quote":{"handle":"FCEA29D3-5BB5-4174-B7A9-1DEE77CEDC46","display_name":"橘AI","text":"听 @少楠Plidezus 说他已经不用 AI 写东西了\n\n它写的东西终归是它的\n\n写完之后自己没有印象\n\n写作最重要的目的不是流量\n\n是形成自己的印记\n\n狠狠的+1","url":"https://m.okjike.com/users/FCEA29D3-5BB5-4174-B7A9-1DEE77CEDC46"},"avatar":"https://cdnv2.ruguoapp.com/FmtwuafewTTtdX3XezBXlN2OsOvDv3.jpg?imageMogr2/auto-orient/heic-exif/1/format/jpeg/thumbnail/!1000x1000r/gravity/Center/crop/!1000x1000a0a0"},"translated":false},{"id":"jike-160F8D03-E580-4799-8D02-B86B1A6FBF64:https://m.okjike.com/originalPosts/6af50a1f136b2761c604775d","kind":"post","channel":null,"source_id":"jike-160F8D03-E580-4799-8D02-B86B1A6FBF64","source_name":"范冰_XDash","title":"","summary":"为什么王健林最能共情的超级英雄应该是幻视？ 因为他们都失去了 Wanda。","body":"为什么王健林最能共情的超级英雄应该是幻视？\n\n因为他们都失去了 Wanda。","url":"https://m.okjike.com/originalPosts/6af50a1f136b2761c604775d","image":null,"published_at":"2026-11-12T08:36:47+08:00","fetched_at":"2026-11-26T15:09:32+08:00","lang":"zh","blogger":{"platform":"jike","handle":"160F8D03-E580-4799-8D02-B86B1A6FBF64","display_name":"范冰_XDash","media":[],"quote":null,"avatar":"https://cdnv2.ruguoapp.com/Foka9bVHVUlqs39pQ-QN5kg6Mu3kv3.jpg?imageMogr2/auto-orient/heic-exif/1/format/jpeg/thumbnail/!1000x1000r/gravity/Center/crop/!1000x1000a0a0"},"translated":false},{"id":"jike-C0052298-F57E-483F-9BBA-0C6BF17AB59E:https://m.okjike.com/originalPosts/6aef38d9320fd7e1b5d33cfa","kind":"post","channel":null,"source_id":"jike-C0052298-F57E-483F-9BBA-0C6BF17AB59E","source_name":"修振","title":"","summary":"半年没更新，交个作业 🙋 我是修振，在大厂做了 10 年金融科技 PM。 4 月在这里发过“做了 4 个副业产品，目前都没火”，后来也确实没火 😂 但这半年下班和周末一直没停，一个人用 Claude Code 把手上的产品做到了 5 个： 📷 会出片：到了地方拍一张现场，AI 给 3 个能照着拍的姿势，拍照时屏幕上有人物轮廓，帮男朋友 / 老公拍出好照片。刚开始朋友内测 💄 妆搭子：在小红书刷到喜…","body":"半年没更新，交个作业 🙋\n\n我是修振，在大厂做了 10 年金融科技 PM。\n\n4 月在这里发过“做了 4 个副业产品，目前都没火”，后来也确实没火 😂\n\n但这半年下班和周末一直没停，一个人用 Claude Code 把手上的产品做到了 5 个：\n\n📷 会出片：到了地方拍一张现场，AI 给 3 个能照着拍的姿势，拍照时屏幕上有人物轮廓，帮男朋友 / 老公拍出好照片。刚开始朋友内测\n\n💄 妆搭子：在小红书刷到喜欢的妆，截图发给它，先看画在自己脸上的效果，再一步步教你画出来。小红书负责让你心动，它负责让你学会\n\n🎙 有人在听：AI 语音陪伴，长期记忆最懂你，做你最贴心的“Her”\n\n🗺 ChinaLocal：给外国人用的中国旅行规划和行前准备、本地生活助手\n\n🦌 鹿鸣 AI Flow：语音工作助手，把随口说的话整理成能直接发出去的文案和会议纪要，还能陪你练话术，先给金融客户经理用\n\n最大的感受：写代码已经不是瓶颈了，难的是想清楚“谁在什么场景下真的需要它”，以及备案、审核、成本这些做产品之外的事。\n\n接下来会把每个产品踩过的坑和真实数据都写出来。\n\n大家最想先看哪一块？AI 产品备案 / 模型成本 / 怎么让 AI 写出能上线的代码","url":"https://m.okjike.com/originalPosts/6aef38d9320fd7e1b5d33cfa","image":{"url":"https://cdnv2.ruguoapp.com/FksFgFg0GC29BbdwoLvJ6H4zEBrmv3.jpg"},"published_at":"2026-11-07T22:42:33+08:00","fetched_at":"2026-11-26T15:09:32+08:00","lang":"zh","blogger":{"platform":"jike","handle":"C0052298-F57E-483F-9BBA-0C6BF17AB59E","display_name":"修振","media":[{"type":"image","url":"https://cdnv2.ruguoapp.com/FksFgFg0GC29BbdwoLvJ6H4zEBrmv3.jpg"}],"quote":null,"avatar":"https://cdnv2.ruguoapp.com/FtY-fyLejDVyal6TqqYBIvtgRftLv3.jpg?imageMogr2/auto-orient/heic-exif/1/format/jpeg/thumbnail/!1000x1000r/gravity/Center/crop/!1000x1000a0a0"},"translated":false},{"id":"jike-2d619b75-fc6a-4151-8125-156762ab46dc:https://m.okjike.com/originalPosts/6aec1d7ac22cdf159dea1e5e","kind":"post","channel":null,"source_id":"jike-2d619b75-fc6a-4151-8125-156762ab46dc","source_name":"王登科","title":"","summary":"试作AI赋一篇： 夫天地有大美，日月有常明；万物各循其道，群生咸遂其情。人居其间，仰观俯察，始结绳以记往，继刻字以传声。竹帛载千秋之事，图书开万世之明。及至电流飞而消息疾，机轮转而百工兴；方寸之间，已通四海；须臾之顷，尽览群经。 今者智机既出，世道方新。采古今之遗文，习天下之妙义；对问能答，因言成篇。虽无耳目，而能辨丹青之色；虽非宫商，而能和金石之音。朝与之论星辰，暮与之谈草木；一念初萌，万端毕陈…","body":"试作AI赋一篇：\n\n夫天地有大美，日月有常明；万物各循其道，群生咸遂其情。人居其间，仰观俯察，始结绳以记往，继刻字以传声。竹帛载千秋之事，图书开万世之明。及至电流飞而消息疾，机轮转而百工兴；方寸之间，已通四海；须臾之顷，尽览群经。\n\n今者智机既出，世道方新。采古今之遗文，习天下之妙义；对问能答，因言成篇。虽无耳目，而能辨丹青之色；虽非宫商，而能和金石之音。朝与之论星辰，暮与之谈草木；一念初萌，万端毕陈。\n\n若夫长风起于青萍，巨浪生于细流。一机既发，百业相求：工师得之，以巧制器；医者借之，以详辨疾；耕夫望岁，可知风雨之期；学子披书，更得商量之友。高山不以路远而隔，深理或因善问而明。昔日穷年之索，今朝片刻可寻；往时一人之志，今日众智相成。\n\n然则器愈利者，其用愈宜审；术愈奇者，其心愈当平。机能续句，未必知言下之悲欢；机可绘形，何曾见窗前之雨雪？答虽迅而或谬，辞虽美而未真。若尽信其言，则浮华易掩事实；若尽委其事，则便利恐失思量。故用之贵于明辨，驭之本乎人心。\n\n况夫江海不辞细流，故能成其深广；文明不弃新术，方可启其光华。使耕者少劳而有获，学者无碍以求知；使孤灯之下，有问可应；使远路之前，有伴同行。则匠心虽寄于方寸，妙用可被于八荒；灵思既通于万类，仁怀犹系乎苍生。\n\n嗟乎！星河万里，犹待登临；天地一书，未穷探索。愿持审慎之心，以赴崭新之世；借千机之力，共成人间之梦。使山海虽遥，问之可达；使微光不灭，聚而成明。","url":"https://m.okjike.com/originalPosts/6aec1d7ac22cdf159dea1e5e","image":null,"published_at":"2026-11-05T14:08:58+08:00","fetched_at":"2026-11-26T15:09:32+08:00","lang":"zh","blogger":{"platform":"jike","handle":"2d619b75-fc6a-4151-8125-156762ab46dc","display_name":"王登科","media":[],"quote":null,"avatar":"https://cdnv2.ruguoapp.com/FiMkNzLzHW7Mm3yg5tqsqbgiSt5w?imageMogr2/auto-orient/heic-exif/1/format/jpeg/thumbnail/!1000x1000r/gravity/Center/crop/!1000x1000a0a0"},"translated":false},{"id":"jike-160F8D03-E580-4799-8D02-B86B1A6FBF64:https://m.okjike.com/originalPosts/6aea9959b8cb8d00dd62048f","kind":"post","channel":null,"source_id":"jike-160F8D03-E580-4799-8D02-B86B1A6FBF64","source_name":"范冰_XDash","title":"","summary":"为什么机械工业时代，明明大规模应用上省力杠杆了，工厂里的牛马反而变多了？ 因为 滑轮添奴。","body":"为什么机械工业时代，明明大规模应用上省力杠杆了，工厂里的牛马反而变多了？\n\n因为 滑轮添奴。","url":"https://m.okjike.com/originalPosts/6aea9959b8cb8d00dd62048f","image":null,"published_at":"2026-11-04T10:32:57+08:00","fetched_at":"2026-11-26T15:09:32+08:00","lang":"zh","blogger":{"platform":"jike","handle":"160F8D03-E580-4799-8D02-B86B1A6FBF64","display_name":"范冰_XDash","media":[],"quote":null,"avatar":"https://cdnv2.ruguoapp.com/Foka9bVHVUlqs39pQ-QN5kg6Mu3kv3.jpg?imageMogr2/auto-orient/heic-exif/1/format/jpeg/thumbnail/!1000x1000r/gravity/Center/crop/!1000x1000a0a0"},"translated":false},{"id":"jike-160F8D03-E580-4799-8D02-B86B1A6FBF64:https://m.okjike.com/originalPosts/6ae921c2136b2761c6b9d220","kind":"post","channel":null,"source_id":"jike-160F8D03-E580-4799-8D02-B86B1A6FBF64","source_name":"范冰_XDash","title":"","summary":"老登为什么不适合在加油站工作？ 因为他容易油枪滑掉。","body":"老登为什么不适合在加油站工作？\n\n因为他容易油枪滑掉。","url":"https://m.okjike.com/originalPosts/6ae921c2136b2761c6b9d220","image":null,"published_at":"2026-11-03T07:50:26+08:00","fetched_at":"2026-11-26T15:09:32+08:00","lang":"zh","blogger":{"pla