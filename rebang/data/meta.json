","count":5,"label":"5"},{"emoji":"❤","count":2,"label":"2"}],"fetched_at":"2026-11-28T10:06:40+08:00"}}]},{"slug":"world","name":"环球","order":2,"desc":"国际上正在发生的大事","sources":["BBC World","卫报 World","CNA International","France 24 English","DW World","NPR World"],"source_platforms":{"bbc-world":"feed","guardian-world":"feed","cna-world":"feed","france24-en":"feed","dw-world":"feed","npr-world":"feed"},"unavailable":[{"id":"guardian-world","name":"卫报 World","status":"error","error":"blocked"}],"total":84,"feed_total":84,"merged_total":0,"pages":3,"banner":[]},{"slug":"finance","name":"财经","order":3,"desc":"市场、公司与宏观经济","sources":["华尔街见闻·财经时讯","Time经济观察","华尔街日报","敏感经济信息分享"],"source_platforms":{"FinanceNewsDaily":"telegram","TimeHorizonX":"telegram","HuaErJie1":"telegram","pelosi3":"telegram"},"unavailable":[],"total":886,"feed_total":881,"merged_total":0,"pages":30,"banner":[{"id":"pelosi3:30494","kind":"news","channel":"finance","source_id":"pelosi3","source_name":"敏感经济信息分享","title":"解放军再次于福建训练用民船搭起浮桥进行两栖登陆，台湾地方选举前一天仍在演练","summary":"11月27日，路透社报道，根据一张11月5日在福建大埕湾拍摄的卫星照片，显示多艘民船在海面上连成一线，正在进行登陆演练。 据路透社报道，共有8艘民船参演。11月1日至16日的卫星影像记录了船只搭起、又拆除约800米长浮桥的过程。 中华民国国防部向路透社证实，已掌握民船参演情况。一名知情安全官员说，演练到27日仍在继续。 早在2025年3月（视频2），就有网民在广东湛江沙滩拍到多艘特种驳船首尾相连，搭成一座伸向海滩的浮桥进行登陆训练，车辆可以直接开上岸。 同年1月，《海军新闻》也报道过中国突然批量建造这种适合登台作战的特种驳船。 分析认为，解放军正把这类民用和半民用船只纳入两栖作战体系，以弥补正…","url":"https://t.me/pelosi3/30494","image":{"url":"media/pelosi3/30494_1.webp","width":536,"height":800},"published_at":"2026-11-27T23:14:10+08:00","fetched_at":"2026-11-28T10:09:39+08:00","lang":"zh","translated":false,"body":"解放军再次于福建训练用民船搭起浮桥进行两栖登陆，台湾地方选举前一天仍在演练\n\n11月27日，路透社报道，根据一张11月5日在福建大埕湾拍摄的卫星照片，显示多艘民船在海面上连成一线，正在进行登陆演练。\n\n据路透社报道，共有8艘民船参演。11月1日至16日的卫星影像记录了船只搭起、又拆除约800米长浮桥的过程。\n中华民国国防部向路透社证实，已掌握民船参演情况。一名知情安全官员说，演练到27日仍在继续。\n\n早在2025年3月（视频2），就有网民在广东湛江沙滩拍到多艘特种驳船首尾相连，搭成一座伸向海滩的浮桥进行登陆训练，车辆可以直接开上岸。\n\n同年1月，《海军新闻》也报道过中国突然批量建造这种适合登台作战的特种驳船。\n\n分析认为，解放军正把这类民用和半民用船只纳入两栖作战体系，以弥补正规登陆舰数量不足。\n\n11月26日，中国国防部发言人陈曦在回答有关福建舰入列一周年的提问时说，有人民军队保护，“台湾同胞更加安全、更有尊严，腰杆会更硬，底气会更足”。\n路透社就大埕湾这场演练询问中国国防部，截至发稿未获回应。","tg":{"media":[{"type":"image","url":"https://cdn5.telesco.pe/file/uDG8qjfXXN6n0OzI6LgMEiu6FXnuRTTkYMAWUn5bEffdG4G17cPqBgN03Xyw8fIre9NRA9vFYiOOhydoBCQp2LA0gSx6Z6IJBnGXTN9K_T7dg5MxriY-izy7xOO9OGNPpbuoScUO-S25zLMTt8ifBaIppYrUwHnSRnR38GcR8SyuodeUTHHR0KDmQwwYu4Y2BBsimr4-B4-WUOp9PjwZLzSRfuL5v4-DC1gJvbMG6y_qrIUsz71zEAYO9BRpICoMZpR2R9LEYaK_cLBzYQx6qnxP5ZIKGA-8ynMs1Ah2Jn11OUVaXSmF-w1UTHROofZUL9-1NeGman9GorR4Y_qbnA.jpg"},{"type":"video","url":"https://cdn5.telesco.pe/file/5961d6a371.mp4?token=ah_UY3O9owtMDyRfDLIdRuS2w7hkzmTODpg6GyCltJsTAVrJYDs0aTAhzYG0eNYCIbTu0DLc4nXhebC_jzwPICb4xJY0IgiAblniH7g6Io9JGd_0yP2czCPyXfugJx6RYGHggS2KpkLUSXH-okbB2egP2Gns7UFsEyIp_vPO-ya-XysFMFCB1ySAcLjiGwcIaCRKOZBZR7NkZbuLTOIvAXQGKMs3ACjJaIVBAGk4kW8i5HVbm4L5AdK6mC4_aDy82Zd8Tedsq5GFIXb26o214R55ks36DONqCUTjoyvWH2Wmipu6J7rhY4YhaGQlJ6Wt-xUBVw_hdjiIXr-sxnZ06w","preview_url":"https://cdn5.telesco.pe/file/j_1O2i9M8Wju26mSn9zVCh-wWq3Wiyq7V4dlw4LSkJoYyndfPdxmoF8jFfZWYibjHJ2Uokv9GUpoLpKd2Qh9phbKfaFAdnh6kfj3w_PelxNdtZs-uy0jZSa7UfGK-i6RFrKYDhXss8ei74Uz-B-1kTDMeEKVeeLTe8fE-iMld5O6C5S363BAPNuB9hg_vi9vbbG210bqD80TXqVPFuJ6k24UdM-2M1BwWOqeDiglafSdkgSpp_qpctSL6Jfp71C-jFYq9RQxEbhEevikaH9xqRbAP67N4GeeVXfjW39S2umbxrIuwq5Rh4v3DldI7e2kNx8EiyVuudLIQtDhgv1ggA"},{"type":"image","url":"https://cdn5.telesco.pe/file/St5ioDbIudx2P2k5EhA77tcCMHB52GYwJFcht7sOFmouNRGWsZFN4flDbmXJrfzZYnxahIGxaUBIIoLgeZb8aimSKAt56-Dn6Kuyl8TUzHdZbd-rT0NN-8WyHQjnDCiId95_eRpw5BJ-sW8YgkrIffrjVaZNbkekQYgrsP4GRnDsr4pNrZeMUbqnAaos8lAxa4Ivhizmwc_0hVXjficigD7vlxr3M0v4avSgWhxuZHR0TQrpTgzIKWfQrTSdXLMMke5uD1JyPN4cgbOVfXGsQ2T1zmQ4hvR6mDEgMaG4uOEdDgLr4noZ_67yhrTrgEZINYlvlt-I-qk3R4AmohjSSg.jpg"},{"type":"image","url":"https://cdn5.telesco.pe/file/kwvGwvpB4H05lMD2yKJn_-c8o5P9hP5XobnhVNZ6HHy8jUdNkyGc6YyolOxsuEqgqgyRZyb7wIc7SwnFJWablK-ogm3R4eniwqB9vk9BffidYIr7g-YNsfWh1tmemILllpvfqUVJWhxM0SNBDXHQlw2mB4CkOtS2sy6056h7Y8svHhqxQxmb_2oG3Elbf9AhxOy89MMMhHrnTiONXrToWwfcgEbH9EZ3CbzGTnH2erlGwWeXuXcJjeHr13EJkCYe0qAmfTtXedYj0FQhK678R